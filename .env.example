# Meta WhatsApp Cloud API (Graph API) - Server-side only
WA_ACCESS_TOKEN=            # permanent System User token
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=              # for webhook signature verification
WA_VERIFY_TOKEN=            # string I set in the Meta dashboard
WA_GRAPH_VERSION=v21.0      # use the latest stable Graph API version; read it from env, never hardcode
NEXT_PUBLIC_WA_BUSINESS_NUMBER=  # digits only, used for wa.me links

# AI Transcription & LLM Extraction (OpenAI Whisper or Groq)
TRANSCRIPTION_PROVIDER=openai     # openai | whisper | mock
TRANSCRIPTION_API_KEY=            # OpenAI or Groq API key for voice note Whisper transcription
LLM_API_KEY=                      # API key for structured requirement extraction
MATCH_WEIGHTS=                    # Optional JSON override for matching engine weights e.g. {"skillOverlap":0.35,"semanticSimilarity":0.25,"experienceFit":0.15,"trustProximity":0.15,"recencyOfActivity":0.10}

# Database URL for Prisma (SQLite for local dev, Postgres-compatible)
DATABASE_URL="file:./dev.db"

