# Optional Gemini Vision API key for automated ID verification OCR in AuthModal
# If not provided, fallback simulated ID verification is used seamlessly
NEXT_PUBLIC_GEMINI_API_KEY=

# Meta WhatsApp Cloud API (Graph API) - Server-side only
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# Public WhatsApp Business Number (Digits only for wa.me links, e.g. 919811022678)
NEXT_PUBLIC_WA_BUSINESS_NUMBER=919811022678

# AI Transcription & LLM Extraction (OpenAI Whisper or Groq)
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
LLM_API_KEY=
MATCH_WEIGHTS=

# Database URL for Prisma (SQLite for local dev, Postgres-compatible)
DATABASE_URL="file:./dev.db"

# Legal Pages & Compliance Configuration
NEXT_PUBLIC_COMPANY_NAME="KIN Living Network"
NEXT_PUBLIC_CONTACT_EMAIL="privacy@kin-path.vercel.app"
NEXT_PUBLIC_SITE_URL="https://kin-path.vercel.app"
NEXT_PUBLIC_POLICY_UPDATED="October 17, 2026"


