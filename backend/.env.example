# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
PROJECT_NAME="Conduit Alumni Network API"
API_V1_STR="/api/v1"

# Database Configuration (Neon Cloud PostgreSQL or local SQLite)
# Format for Neon: postgresql://username:password@ep-xxxx.c-3.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./alumni_network.db

# JWT Authentication
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Google Gemini Generative AI Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
