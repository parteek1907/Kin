# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
PROJECT_NAME="Conduit Alumni Network API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production/development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_network

# JWT Authentication
# IMPORTANT: Generate a strong secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional AI Provider Configuration
# If unset, the backend runs seamlessly using deterministic logic
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
